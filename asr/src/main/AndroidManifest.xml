<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Microphone is the only sensitive permission. There is no INTERNET permission, ever. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <application>
        <!-- Separate process: a model/native crash or OOM can never take the keyboard down. -->
        <service
            android:name="dev.aster.keyboard.asr.AsrService"
            android:process=":asr"
            android:exported="false" />
    </application>
</manifest>
